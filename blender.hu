{
    // From-source Blender (editor + a matching `bpy` module), ADDED as pinnable install methods on
    // base configsys's `blender`. Base's native package stays the DEFAULT — nothing auto-builds.
    // You choose a GPU flavor by PINNING its method (control over automation):
    //
    //   configsys pin blender blender-cuda     # then `install blender` builds Cycles with CUDA
    //   configsys pin blender blender-optix    # CUDA + OptiX (needs the EULA-gated SDK, see below)
    //   configsys pin blender blender-hip      # AMD ROCm/HIP
    //   configsys pin blender blender-build    # plain CPU build
    //   configsys pin blender native           # back to the distro package
    //
    // Each flavor is its OWN `via:` (a thin subclass of the one build driver, presetting the
    // backend). The binding names the SDK that flavor needs in `requires:` (from base routes.hu),
    // so pinning it makes the toolkit install itself; a flavor you never pin drags in nothing. The
    // driver maps the backend to Cycles CMake flags and refuses to build if a toolchain is missing.
    //
    // The GPU flavors carry a `when:` on the vendor they need (the shared `gpu` facet), so the
    // Components screen only offers the ones valid on THIS machine (CUDA/OptiX on nvidia, HIP on
    // amd, oneAPI when you set `facets.gpu intel`); the CPU build is always offered. Profiles shows
    // them all, for authoring across machines. `configsys where blender` lists the methods valid here.
    components: {
        blender: {
            // Every source variant needs gcc-11 — Blender 4.3's REFERENCE (known-good) compiler.
            // Requiring it guarantees the recipe's "fall back off a too-new default g++" step has the
            // right compiler to reach for, instead of hoping it's installed. gcc-11 is parallel-
            // installable on debian/ubuntu (apt, ubuntu-toolchain-r PPA) and on rhel/EL (the
            // gcc-toolset-11 SCL under /opt/rh) — both purely additive, no toolchain rollback.
            // NOT on FEDORA, though: its repos ship only the latest gcc (14/15) with no parallel
            // gcc11/gcc12 compat package, and no clean COPR provides one at /usr/bin/gcc-11
            // (slaanesh/cuda-gcc is CUDA-host-specific — /usr/bin/cuda-gcc, and tracks gcc-13, too new
            // for OpenColorIO's cstdint). So on fedora this is an honest unmet-require at resolve/check
            // time, not a silent mid-build failure on a too-new gcc — until fedora packages a gcc <=12
            // or we add a from-source gcc-11 build. The nvcc host-compiler cap is handled separately
            // in the recipe.
            install: [
                { via: blender-build  ref: v4.3.2  dir: blender-git  target: both  requires: [ gcc-11 ]  suggests: blender-source-glue }   // CPU — valid anywhere
                { via: blender-cuda   ref: v4.3.2  dir: blender-git  target: both  when: "gpu:nvidia"  requires: [ cuda-toolkit, gcc-11 ]  suggests: blender-source-glue }   // NVIDIA CUDA
                { via: blender-hip    ref: v4.3.2  dir: blender-git  target: both  when: "gpu:amd"     requires: [ rocm-hip, gcc-11 ]  suggests: blender-source-glue }       // AMD HIP
                { via: blender-oneapi ref: v4.3.2  dir: blender-git  target: both  when: "gpu:intel"   requires: [ intel-oneapi-basekit, gcc-11 ]  suggests: blender-source-glue }  // Intel oneAPI (set facets.gpu intel)
                { via: blender-optix  ref: v4.3.2  dir: blender-git  target: both  when: "gpu:nvidia"  requires: [ cuda-toolkit, gcc-11 ]  suggests: blender-source-glue     // NVIDIA CUDA + OptiX
                  optix-root: $CONFIGSYS_SDK_DIR/optix/NVIDIA-OptiX-SDK-8.0.0-linux64-x86_64   // Blender 4.3 wants OptiX 8.x; unpack the EULA SDK under ~/sdks/optix/ (several versions can coexist there)
                  optix-max-version: 8 }                                      // warn if the SDK is newer
            ]
        }
        // The source methods' SHELL GLUE: the built editor first on PATH (ahead of a distro
        // /usr/bin/blender) + `blender-python` for the matching bpy interpreter. Each source binding
        // `suggests:` it, so it attaches only while a source method is blender's install method — and
        // configsys removes it when you switch method (`pin blender native`) or remove blender.
        // Snippets ship in this plugin's glue/shell/<shell>/blender-source.* (bash/zsh/fish/nu/elvish).
        blender-source-glue: { description: "From-source Blender on PATH (+ `blender-python` for its bpy)."
            install: [ { via: glue  requires: shell-glue  glue: blender-source } ]
        }
    }
}
